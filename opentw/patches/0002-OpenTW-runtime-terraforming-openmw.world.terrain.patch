diff --git a/apps/openmw/mwlua/terrainbindings.cpp b/apps/openmw/mwlua/terrainbindings.cpp
new file mode 100644
index 0000000..81b1ac0
--- /dev/null
+++ b/apps/openmw/mwlua/terrainbindings.cpp
@@ -0,0 +1,85 @@
+#include "terrainbindings.hpp"
+
+#include <cmath>
+#include <stdexcept>
+#include <string>
+
+#include <osg/Vec3f>
+
+#include <components/lua/luastate.hpp>
+#include <components/misc/finitevalues.hpp>
+
+#include "../mwbase/environment.hpp"
+#include "../mwbase/world.hpp"
+#include "../mwworld/esmstore.hpp"
+#include "../mwworld/terraformer.hpp"
+
+#include "context.hpp"
+#include "luamanagerimp.hpp"
+
+namespace MWLua
+{
+    namespace
+    {
+        // Edits are applied on the main thread after the Lua update, in the order they were made.
+        // reach: how far around center actors may need to be put back on the ground.
+        template <class Fn>
+        void queue(const Context& context, const osg::Vec3f& center, float reach, std::string_view name, Fn&& fn)
+        {
+            context.mLuaManager->addAction(
+                [center, reach, fn = std::forward<Fn>(fn)] {
+                    MWBase::World& world = *MWBase::Environment::get().getWorld();
+                    world.refreshTerrain(fn(world.getTerraformer()), center, reach + 256.f);
+                },
+                name);
+        }
+    }
+
+    sol::table initWorldTerrainBindings(const Context& context)
+    {
+        using Misc::FiniteFloat;
+        sol::state_view lua = context.sol();
+        sol::table api(lua, sol::create);
+
+        // Lets mods detect OpenTW: `if world.terrain then ... end`
+        api["VERSION"] = 1;
+
+        api["flatten"] = [context](const osg::Vec3f& center, FiniteFloat radius, FiniteFloat height,
+                             sol::optional<FiniteFloat> falloff) {
+            const float r = radius;
+            const float f = falloff ? static_cast<float>(*falloff) : r * 0.5f;
+            const float h = height;
+            queue(context, center, r + f, "terrain.flatten", [=](MWWorld::Terraformer& t) {
+                return t.flatten(osg::Vec2f(center.x(), center.y()), r, f, h);
+            });
+        };
+
+        api["raise"] = [context](const osg::Vec3f& center, FiniteFloat radius, FiniteFloat delta,
+                           sol::optional<FiniteFloat> falloff) {
+            const float r = radius;
+            const float f = falloff ? static_cast<float>(*falloff) : r * 0.5f;
+            const float d = delta;
+            queue(context, center, r + f, "terrain.raise", [=](MWWorld::Terraformer& t) {
+                return t.raise(osg::Vec2f(center.x(), center.y()), r, f, d);
+            });
+        };
+
+        api["paint"] = [context](const osg::Vec3f& center, FiniteFloat radius, std::string_view texture) {
+            const auto found
+                = MWBase::Environment::get().getESMStore()->get<ESM::LandTexture>().searchIndex(texture);
+            if (!found)
+                throw std::runtime_error("Unknown land texture: " + std::string(texture));
+            const float r = radius;
+            const auto [plugin, index] = *found;
+            queue(context, center, 0.f, "terrain.paint", [=](MWWorld::Terraformer& t) {
+                return t.paint(osg::Vec2f(center.x(), center.y()), r, index, plugin);
+            });
+        };
+
+        api["reset"] = [context]() {
+            queue(context, osg::Vec3f(), 0.f, "terrain.reset", [](MWWorld::Terraformer& t) { return t.reset(); });
+        };
+
+        return LuaUtil::makeReadOnly(api);
+    }
+}
