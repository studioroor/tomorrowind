+    std::optional<std::pair<int, std::uint32_t>> Store<ESM::LandTexture>::searchIndex(
+        std::string_view idOrTexture) const
+    {
+        // "textures\tx_sand.dds" -> "tx_sand"
+        const auto stem = [](std::string_view s) {
+            const std::size_t slash = s.find_last_of("/\\");
+            if (slash != std::string_view::npos)
+                s = s.substr(slash + 1);
+            const std::size_t dot = s.find_last_of('.');
+            if (dot != std::string_view::npos)
+                s = s.substr(0, dot);
+            return s;
+        };
+        const ESM::RefId id = ESM::RefId::stringRefId(idOrTexture);
+        for (const auto& [pluginIndex, ltexId] : mMappings)
+            if (ltexId == id)
+                return pluginIndex;
+        const std::string_view wanted = stem(idOrTexture);
+        for (const auto& [pluginIndex, ltexId] : mMappings)
+        {
+            const auto texture = mStatic.find(ltexId);
+            if (texture != mStatic.end() && Misc::StringUtils::ciEqual(stem(texture->second.getOriginal()), wanted))
+                return pluginIndex;
+        }
+        return std::nullopt;
+    }
