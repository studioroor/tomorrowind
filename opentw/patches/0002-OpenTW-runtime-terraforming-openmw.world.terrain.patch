+    void Scene::addTerrainCollision(
+        const ESM::ExteriorCellLocation& cellIndex, const DetourNavigator::UpdateGuard* navigatorUpdateGuard)
+    {
+        using DetourNavigator::HeightfieldShape;
+        const int cellX = cellIndex.mX;
+        const int cellY = cellIndex.mY;
+        const ESM::RefId worldspace = cellIndex.mWorldspace;
+        std::shared_ptr<const ESMTerrain::LandObject> land = mRendering.getLandManager()->getLand(cellIndex);
+        const ESM::LandData* data = land ? land->getData(ESM::Land::DATA_VHGT) : nullptr;
+        const int verts = ESM::getLandSize(worldspace);
+        const int worldsize = ESM::getCellSize(worldspace);
+
+        if (data)
+        {
+            mPhysics->addHeightField(data->getHeights().data(), cellX, cellY, worldsize, verts,
+                data->getMinHeight(), data->getMaxHeight(), std::move(land));
+        }
+        else if (!ESM::isEsm4Ext(worldspace))
+        {
+            static const std::vector<float> defaultHeight(verts * verts, ESM::Land::DEFAULT_HEIGHT);
+            mPhysics->addHeightField(defaultHeight.data(), cellX, cellY, worldsize, verts,
+                ESM::Land::DEFAULT_HEIGHT, ESM::Land::DEFAULT_HEIGHT, std::move(land));
+        }
+        if (mPhysics->getHeightField(cellX, cellY))
+        {
+            const osg::Vec2i cellPosition(cellX, cellY);
+            const HeightfieldShape shape = [&]() -> HeightfieldShape {
+                if (data == nullptr)
+                {
+                    return DetourNavigator::HeightfieldPlane{ static_cast<float>(ESM::Land::DEFAULT_HEIGHT) };
+                }
+                else
+                {
+                    DetourNavigator::HeightfieldSurface heights;
+                    heights.mHeights = data->getHeights().data();
+                    heights.mSize = static_cast<std::size_t>(data->getLandSize());
+                    heights.mMinHeight = data->getMinHeight();
+                    heights.mMaxHeight = data->getMaxHeight();
+                    return heights;
+                }
+            }();
+            mNavigator.addHeightfield(cellPosition, worldsize, shape, navigatorUpdateGuard);
+        }
+    }
+
+    void Scene::reloadTerrain(const std::vector<std::pair<int, int>>& cells)
+    {
+        // OpenTW: the land of these cells was edited. Swap the collision and navmesh heightfields of the
+        // ones that are loaded. Navmesh first: it reads the heights through a pointer the physics
+        // heightfield keeps alive.
+        bool changed = false;
+        for (CellStore* cell : mActiveCells)
+        {
+            const MWWorld::Cell& c = *cell->getCell();
+            if (!c.isExterior() || c.getWorldSpace() != ESM::Cell::sDefaultWorldspaceId)
+                continue;
+            const std::pair<int, int> pos(c.getGridX(), c.getGridY());
+            if (std::find(cells.begin(), cells.end(), pos) == cells.end())
+                continue;
+            mNavigator.removeHeightfield(osg::Vec2i(pos.first, pos.second), nullptr);
+            mPhysics->removeHeightField(pos.first, pos.second);
+            addTerrainCollision(ESM::ExteriorCellLocation(pos.first, pos.second, c.getWorldSpace()), nullptr);
+            changed = true;
+        }
+        if (changed)
+            mNavigator.update(mWorld.getPlayerPtr().getRefData().getPosition().asVec3(), nullptr);
+    }
