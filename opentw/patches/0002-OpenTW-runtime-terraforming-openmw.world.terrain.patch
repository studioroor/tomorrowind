+#ifndef OPENTW_MWWORLD_TERRAFORMER_H
+#define OPENTW_MWWORLD_TERRAFORMER_H
+
+#include <atomic>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include <osg/Vec2f>
+
+#include <components/esm3/landrecorddata.hpp>
+
+namespace ESMTerrain
+{
+    class LandObject;
+}
+
+namespace MWWorld
+{
+    class ESMStore;
+
+    /// OpenTW: runtime terrain editing for the default (Morrowind) worldspace.
+    ///
+    /// Keeps an edited copy of every land record that was changed. The renderer, physics and navmesh pick
+    /// these copies up through MWRender::LandManager; World::refreshTerrain() tells them to reload.
+    /// Edits are not written to saved games: the caller (a Lua mod) owns them and re-applies them on load.
+    ///
+    /// Brushes work on the global vertex grid (128 units between vertices, 64 per cell), so the vertices
+    /// two neighbouring cells share always stay equal and no seams open up.
+    class Terraformer
+    {
+    public:
+        using CellPos = std::pair<int, int>;
+
+        explicit Terraformer(const ESMStore& store);
+        ~Terraformer();
+
+        /// Thread-safe (terrain is built on background threads). nullptr when the cell has no edits.
+        std::shared_ptr<const ESMTerrain::LandObject> makeLandObject(int cellX, int cellY) const;
+
+        /// Texture of a texel of an edited cell: {VTEX value (LTEX index + 1, 0 = default), plugin}.
+        std::optional<std::pair<std::uint16_t, int>> getTexture(int cellX, int cellY, int tx, int ty) const;
+
+        bool hasEdits() const;
+
+        /// Changes with every edit. Thread-safe.
+        std::uint64_t getRevision() const { return mRevision; }
+
+        // Brushes, in world units. Full effect within radius, fading out (smoothstep) over falloff.
+        // Each returns the cells whose land data changed.
+
+        /// Pull the ground towards height.
+        std::vector<CellPos> flatten(const osg::Vec2f& center, float radius, float falloff, float height);
+        /// Raise (or, with a negative delta, lower) the ground.
+        std::vector<CellPos> raise(const osg::Vec2f& center, float radius, float falloff, float delta);
+        /// Paint every texel whose centre is within radius. index is the LTEX index (not +1).
+        std::vector<CellPos> paint(const osg::Vec2f& center, float radius, std::uint32_t index, int plugin);
+        /// Undo all edits.
+        std::vector<CellPos> reset();
+
+    private:
+        struct Cell
+        {
+            ESM::LandRecordData mData;
+            std::vector<int> mTexturePlugins;
+            int mPlugin = 0;
+        };
+
+        using Changed = std::map<CellPos, bool>;
+
+        const Cell& source(CellPos pos);
+        Cell& edit(CellPos pos, Changed& changed);
+        float height(int gx, int gy);
+        template <class Fn>
+        void forEachCopy(int gx, int gy, Fn&& fn);
+        void setHeight(int gx, int gy, float h, Changed& changed);
+        void updateNormals(int gx0, int gy0, int gx1, int gy1, Changed& changed);
+        std::vector<CellPos> finish(Changed& changed);
+        template <class Fn>
+        std::vector<CellPos> brush(const osg::Vec2f& center, float radius, float falloff, Fn&& newHeight);
+
+        const ESMStore& mStore;
+        mutable std::mutex mMutex;
+        std::atomic<std::uint64_t> mRevision{ 0 };
+        std::map<CellPos, Cell> mEdits;
+        std::map<CellPos, Cell> mOriginals; // unedited land, loaded once
+    };
+}
+
+#endif
