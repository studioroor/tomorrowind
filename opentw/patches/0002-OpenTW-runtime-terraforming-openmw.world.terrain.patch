diff --git a/apps/openmw/mwworld/terraformer.cpp b/apps/openmw/mwworld/terraformer.cpp
new file mode 100644
index 0000000..d69582b
--- /dev/null
+++ b/apps/openmw/mwworld/terraformer.cpp
@@ -0,0 +1,290 @@
+#include "terraformer.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+#include <components/esm3/loadland.hpp>
+#include <components/esmterrain/storage.hpp>
+
+#include "esmstore.hpp"
+
+namespace MWWorld
+{
+    namespace
+    {
+        constexpr int sCellVerts = ESM::Land::LAND_SIZE - 1; // 64 vertex steps per cell
+        constexpr float sCellSize = static_cast<float>(ESM::Land::REAL_SIZE);
+        constexpr float sVertexSpacing = sCellSize / sCellVerts; // 128
+        constexpr int sTexels = ESM::Land::LAND_TEXTURE_SIZE; // 16 per side
+        constexpr float sTexelSize = sCellSize / sTexels; // 512
+        constexpr float sMaxBrush = sCellSize * 4;
+        constexpr int sAllData = ESM::Land::DATA_VHGT | ESM::Land::DATA_VNML | ESM::Land::DATA_VCLR
+            | ESM::Land::DATA_VTEX;
+
+        int floorDiv(int a, int b)
+        {
+            return a >= 0 ? a / b : -((-a + b - 1) / b);
+        }
+
+        float weight(float distance, float radius, float falloff)
+        {
+            if (distance <= radius)
+                return 1.f;
+            if (falloff <= 0.f || distance >= radius + falloff)
+                return 0.f;
+            const float t = 1.f - (distance - radius) / falloff;
+            return t * t * (3.f - 2.f * t);
+        }
+
+        void checkBrush(float radius, float falloff)
+        {
+            if (!std::isfinite(radius) || !std::isfinite(falloff) || radius < 0 || falloff < 0
+                || radius + falloff > sMaxBrush)
+                throw std::runtime_error("terrain brush: radius + falloff must be between 0 and 32768");
+        }
+    }
+
+    Terraformer::Terraformer(const ESMStore& store)
+        : mStore(store)
+    {
+    }
+
+    Terraformer::~Terraformer() = default;
+
+    std::shared_ptr<const ESMTerrain::LandObject> Terraformer::makeLandObject(int cellX, int cellY) const
+    {
+        const std::lock_guard lock(mMutex);
+        const auto it = mEdits.find({ cellX, cellY });
+        if (it == mEdits.end())
+            return nullptr;
+        return std::make_shared<const ESMTerrain::LandObject>(
+            it->second.mData, it->second.mPlugin, it->second.mTexturePlugins);
+    }
+
+    std::optional<std::pair<std::uint16_t, int>> Terraformer::getTexture(int cellX, int cellY, int tx, int ty) const
+    {
+        const std::lock_guard lock(mMutex);
+        const auto it = mEdits.find({ cellX, cellY });
+        if (it == mEdits.end() || tx < 0 || ty < 0 || tx >= sTexels || ty >= sTexels)
+            return std::nullopt;
+        const std::size_t i = static_cast<std::size_t>(ty * sTexels + tx);
+        return std::make_pair(it->second.mData.mTextures[i], it->second.mTexturePlugins[i]);
+    }
+
+    bool Terraformer::hasEdits() const
+    {
+        const std::lock_guard lock(mMutex);
+        return !mEdits.empty();
+    }
+
+    const Terraformer::Cell& Terraformer::source(CellPos pos)
+    {
+        if (const auto it = mEdits.find(pos); it != mEdits.end())
+            return it->second;
+        if (const auto it = mOriginals.find(pos); it != mOriginals.end())
+            return it->second;
+
+        Cell& cell = mOriginals[pos];
+        cell.mData.mDataLoaded = 0;
+        if (const ESM::Land* land = mStore.get<ESM::Land>().search(pos.first, pos.second))
+        {
+            land->loadData(sAllData, cell.mData);
+            cell.mPlugin = land->getPlugin();
+        }
+        // Cells without land (open sea) start as the flat sea floor the engine shows there anyway
+        ESM::LandRecordData& d = cell.mData;
+        if (!(d.mDataLoaded & ESM::Land::DATA_VHGT))
+        {
+            d.mHeights.fill(static_cast<float>(ESM::Land::DEFAULT_HEIGHT));
+            d.mMinHeight = d.mMaxHeight = static_cast<float>(ESM::Land::DEFAULT_HEIGHT);
+        }
+        if (!(d.mDataLoaded & ESM::Land::DATA_VNML))
+            for (std::size_t i = 0; i < d.mNormals.size(); i += 3)
+            {
+                d.mNormals[i] = 0;
+                d.mNormals[i + 1] = 0;
+                d.mNormals[i + 2] = 127;
+            }
+        if (!(d.mDataLoaded & ESM::Land::DATA_VCLR))
+            d.mColours.fill(255);
+        if (!(d.mDataLoaded & ESM::Land::DATA_VTEX))
+            d.mTextures.fill(0);
+        d.mDataLoaded = sAllData;
+        cell.mTexturePlugins.assign(ESM::Land::LAND_NUM_TEXTURES, cell.mPlugin);
+        return cell;
+    }
+
+    Terraformer::Cell& Terraformer::edit(CellPos pos, Changed& changed)
+    {
+        changed[pos] = true;
+        if (const auto it = mEdits.find(pos); it != mEdits.end())
+            return it->second;
+        const Cell copy = source(pos);
+        return mEdits.emplace(pos, copy).first->second;
+    }
+
+    float Terraformer::height(int gx, int gy)
+    {
+        const int cx = floorDiv(gx, sCellVerts);
+        const int cy = floorDiv(gy, sCellVerts);
+        const int lx = gx - cx * sCellVerts;
+        const int ly = gy - cy * sCellVerts;
+        return source({ cx, cy }).mData.mHeights[ly * ESM::Land::LAND_SIZE + lx];
+    }
+
+    // A vertex on a cell edge is stored in every cell that touches it (up to four). fn(cell, vertexIndex).
+    template <class Fn>
+    void Terraformer::forEachCopy(int gx, int gy, Fn&& fn)
+    {
+        const int cx = floorDiv(gx, sCellVerts);
+        const int cy = floorDiv(gy, sCellVerts);
+        const int lx = gx - cx * sCellVerts;
+        const int ly = gy - cy * sCellVerts;
+        const int nx = lx == 0 ? 2 : 1;
+        const int ny = ly == 0 ? 2 : 1;
+        for (int ix = 0; ix < nx; ++ix)
+            for (int iy = 0; iy < ny; ++iy)
+            {
+                const int cellX = cx - ix;
+                const int cellY = cy - iy;
+                const int vx = ix ? sCellVerts : lx;
+                const int vy = iy ? sCellVerts : ly;
+                fn(CellPos{ cellX, cellY }, vy * ESM::Land::LAND_SIZE + vx);
+            }
+    }
+
+    void Terraformer::setHeight(int gx, int gy, float h, Changed& changed)
+    {
+        forEachCopy(gx, gy, [&](CellPos pos, int i) {
+            if (std::abs(source(pos).mData.mHeights[i] - h) < 0.01f)
+                return;
+            edit(pos, changed).mData.mHeights[i] = h;
+        });
+    }
+
+    void Terraformer::updateNormals(int gx0, int gy0, int gx1, int gy1, Changed& changed)
+    {
+        for (int gy = gy0; gy <= gy1; ++gy)
+            for (int gx = gx0; gx <= gx1; ++gx)
+            {
+                osg::Vec3f n(height(gx - 1, gy) - height(gx + 1, gy), height(gx, gy - 1) - height(gx, gy + 1),
+                    2.f * sVertexSpacing);
+                n.normalize();
+                const std::int8_t nx = static_cast<std::int8_t>(std::lround(n.x() * 127.f));
+                const std::int8_t ny = static_cast<std::int8_t>(std::lround(n.y() * 127.f));
+                const std::int8_t nz = static_cast<std::int8_t>(std::lround(n.z() * 127.f));
+                forEachCopy(gx, gy, [&](CellPos pos, int i) {
+                    const auto& normals = source(pos).mData.mNormals;
+                    if (normals[i * 3] == nx && normals[i * 3 + 1] == ny && normals[i * 3 + 2] == nz)
+                        return;
+                    auto& out = edit(pos, changed).mData.mNormals;
+                    out[i * 3] = nx;
+                    out[i * 3 + 1] = ny;
+                    out[i * 3 + 2] = nz;
+                });
+            }
+    }
+
+    std::vector<Terraformer::CellPos> Terraformer::finish(Changed& changed)
+    {
+        std::vector<CellPos> result;
+        for (const auto& [pos, _] : changed)
+        {
+            ESM::LandRecordData& d = mEdits.at(pos).mData;
+            const auto [lo, hi] = std::minmax_element(d.mHeights.begin(), d.mHeights.end());
+            d.mMinHeight = *lo;
+            d.mMaxHeight = *hi;
+            result.push_back(pos);
+        }
+        if (!result.empty())
+            ++mRevision;
+        return result;
+    }
+
+    template <class Fn>
+    std::vector<Terraformer::CellPos> Terraformer::brush(
+        const osg::Vec2f& center, float radius, float falloff, Fn&& newHeight)
+    {
+        checkBrush(radius, falloff);
+        const float reach = radius + falloff;
+        const int gx0 = static_cast<int>(std::floor((center.x() - reach) / sVertexSpacing));
+        const int gx1 = static_cast<int>(std::ceil((center.x() + reach) / sVertexSpacing));
+        const int gy0 = static_cast<int>(std::floor((center.y() - reach) / sVertexSpacing));
+        const int gy1 = static_cast<int>(std::ceil((center.y() + reach) / sVertexSpacing));
+
+        const std::lock_guard lock(mMutex);
+        Changed changed;
+        for (int gy = gy0; gy <= gy1; ++gy)
+            for (int gx = gx0; gx <= gx1; ++gx)
+            {
+                const osg::Vec2f p(gx * sVertexSpacing, gy * sVertexSpacing);
+                const float w = weight((p - center).length(), radius, falloff);
+                if (w <= 0.f)
+                    continue;
+                const float h = height(gx, gy);
+                setHeight(gx, gy, h + (newHeight(h) - h) * w, changed);
+            }
+        if (!changed.empty())
+            updateNormals(gx0 - 1, gy0 - 1, gx1 + 1, gy1 + 1, changed);
+        return finish(changed);
+    }
+
+    std::vector<Terraformer::CellPos> Terraformer::flatten(
+        const osg::Vec2f& center, float radius, float falloff, float height)
+    {
+        return brush(center, radius, falloff, [&](float) { return height; });
+    }
+
+    std::vector<Terraformer::CellPos> Terraformer::raise(
+        const osg::Vec2f& center, float radius, float falloff, float delta)
+    {
+        return brush(center, radius, falloff, [&](float h) { return h + delta; });
+    }
+
+    std::vector<Terraformer::CellPos> Terraformer::paint(
+        const osg::Vec2f& center, float radius, std::uint32_t index, int plugin)
+    {
+        checkBrush(radius, 0.f);
+        const std::uint16_t value = static_cast<std::uint16_t>(index + 1);
+        const int cx0 = static_cast<int>(std::floor((center.x() - radius) / sCellSize)) - 1;
+        const int cx1 = static_cast<int>(std::floor((center.x() + radius) / sCellSize)) + 1;
+        const int cy0 = static_cast<int>(std::floor((center.y() - radius) / sCellSize)) - 1;
+        const int cy1 = static_cast<int>(std::floor((center.y() + radius) / sCellSize)) + 1;
+
+        const std::lock_guard lock(mMutex);
+        Changed changed;
+        for (int cy = cy0; cy <= cy1; ++cy)
+            for (int cx = cx0; cx <= cx1; ++cx)
+                for (int ty = 0; ty < sTexels; ++ty)
+                    for (int tx = 0; tx < sTexels; ++tx)
+                    {
+                        // Texels are drawn a quarter texel off their grid square (see core.land.getTextureAt)
+                        const osg::Vec2f p(cx * sCellSize + (tx + 0.75f) * sTexelSize,
+                            cy * sCellSize + (ty + 0.25f) * sTexelSize);
+                        if ((p - center).length() > radius)
+                            continue;
+                        const std::size_t i = static_cast<std::size_t>(ty * sTexels + tx);
+                        const Cell& src = source({ cx, cy });
+                        if (src.mData.mTextures[i] == value && src.mTexturePlugins[i] == plugin)
+                            continue;
+                        Cell& cell = edit({ cx, cy }, changed);
+                        cell.mData.mTextures[i] = value;
+                        cell.mTexturePlugins[i] = plugin;
+                    }
+        return finish(changed);
+    }
+
+    std::vector<Terraformer::CellPos> Terraformer::reset()
+    {
+        const std::lock_guard lock(mMutex);
+        std::vector<CellPos> result;
+        for (const auto& [pos, _] : mEdits)
+            result.push_back(pos);
+        mEdits.clear();
+        mOriginals.clear();
+        if (!result.empty())
+            ++mRevision;
+        return result;
+    }
+}
