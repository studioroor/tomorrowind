         std::vector<CellPos> raise(const osg::Vec2f& center, float radius, float falloff, float delta);
         /// Paint every texel whose centre is within radius. index is the LTEX index (not +1).
         std::vector<CellPos> paint(const osg::Vec2f& center, float radius, std::uint32_t index, int plugin);
+        /// Paint every texel within radius of the segment from-to (at most 16 cells long).
+        std::vector<CellPos> paintLine(
+            const osg::Vec2f& from, const osg::Vec2f& to, float radius, std::uint32_t index, int plugin);
         /// Undo all edits.
         std::vector<CellPos> reset();
 
diff --git a/apps/openmw/mwworld/worldimp.cpp b/apps/openmw/mwworld/worldimp.cpp
