         void refreshTerrain(
-            const std::vector<std::pair<int, int>>& cells, const osg::Vec3f& center, float radius) override;
+            const std::vector<std::pair<int, int>>& cells, const osg::Vec3f& center, float radius,
+            bool shapeChanged = true) override;
 
         /// Return physical or rendering half extents of the given actor.
         osg::Vec3f getHalfExtents(const MWWorld::ConstPtr& actor, bool rendering = false) const override;
