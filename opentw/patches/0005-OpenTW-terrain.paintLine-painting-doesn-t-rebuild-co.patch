@@ -3597,11 +3597,14 @@ namespace MWWorld
         return mRendering->getTerrainHeightAt(worldPos, worldspace);
     }
 
-    void World::refreshTerrain(const std::vector<std::pair<int, int>>& cells, const osg::Vec3f& center, float radius)
+    void World::refreshTerrain(
+        const std::vector<std::pair<int, int>>& cells, const osg::Vec3f& center, float radius, bool shapeChanged)
     {
         if (cells.empty())
             return;
         mRendering->refreshTerrain(cells);
+        if (!shapeChanged)
+            return;
         mWorldScene->reloadTerrain(cells);
 
         std::vector<Ptr> actors;
