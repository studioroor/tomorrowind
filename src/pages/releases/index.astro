---
import ReleaseList from '../../components/ReleaseList.astro'
import settings from '../../data/settings.json'
import Layout from '../../layouts/Layout.astro'
import { publishedReleases } from '../../releases'

const releases = await publishedReleases()
---

<Layout title="Releases" description={`Release notes for every version of ${settings.name}, with downloads and trailers.`}>
  <div class="wrap page">
    <h1>Releases</h1>
    <p class="intro">
      What changed in each version, newest first. The trailers are on <a href={settings.links.youtube}>YouTube</a>, and
      every download is also on <a href={settings.links.releases}>GitHub</a>.
    </p>
    <ReleaseList releases={releases} />
  </div>
</Layout>

<style>
  .page {
    padding-top: 3rem;
  }
  h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    color: var(--gold);
  }
  .intro {
    max-width: 38rem;
    font-size: 1.15rem;
    margin-bottom: 2.5rem;
  }
</style>
