---
import { youtubeId } from '../lib'

// Shows the video's thumbnail and loads YouTube (privacy-enhanced mode) only
// when someone presses play. Without JavaScript it's a link to YouTube.
interface Props {
  url: string | undefined
  title: string
  large?: boolean
}
const { url, title, large = false } = Astro.props
const id = youtubeId(url)
const thumb = (size: string) => `https://i.ytimg.com/vi/${id}/${size}.jpg`
---

{
  id && (
    <a
      class:list={['yt', { large }]}
      href={`https://www.youtube.com/watch?v=${id}`}
      data-yt={id}
      data-title={title}
      aria-label={`Play video: ${title}`}
    >
      <img
        src={thumb('maxresdefault')}
        data-fallback={thumb('hqdefault')}
        onerror="this.onerror=null;this.src=this.dataset.fallback"
        alt=""
        loading="lazy"
        width="1280"
        height="720"
      />
      <span class="play" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg>
      </span>
    </a>
  )
}

<script>
  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-yt]')
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return
    event.preventDefault()
    const frame = document.createElement('iframe')
    frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.yt}?autoplay=1&rel=0`
    frame.title = link.dataset.title ?? 'YouTube video'
    frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
    frame.allowFullscreen = true
    // Created here, so it doesn't get Astro's scoped-style attribute: it's
    // sized by the global .yt-frame rule below.
    frame.className = 'yt-frame'
    link.replaceWith(frame)
    frame.focus()
  })
</script>

<style>
  .yt {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    border-radius: 6px;
    background: var(--ground-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 400ms ease, filter 400ms ease;
    filter: saturate(0.9) brightness(0.85);
  }
  .yt:hover img,
  .yt:focus-visible img {
    transform: scale(1.02);
    filter: none;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4.5rem;
    height: 4.5rem;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ground) 70%, transparent);
    border: 2px solid var(--gold);
    backdrop-filter: blur(4px);
  }
  .large .play {
    width: 6rem;
    height: 6rem;
  }
  .play svg {
    width: 45%;
    fill: var(--gold);
    translate: 6% 0;
  }
  :global(.yt-frame) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 6px;
    background: #000;
  }
</style>
